@model IEnumerable<ABCRetail.Models.Customer>

<div class="container-fluid py-4" style="margin-top: 0; padding-top: 20px;">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-2 text-gray-800">Customer Management</h1>
            <p class="text-muted mb-0">Manage your customer database</p>
        </div>
        <div class="btn-group" role="group">
            <a class="btn btn-primary btn-lg shadow-sm" asp-action="Create">
                <i class="fas fa-plus-circle me-2"></i>Add New Customer
            </a>
            <a class="btn btn-outline-info btn-lg shadow-sm" asp-action="Log">
                <i class="fas fa-history me-2"></i>View Log
            </a>
        </div>
    </div>

    <!-- Stats Cards (Optional - if you want to show summary info) -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Customers</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Customer Directory</h6>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#" onclick="filterTable('all')">All Customers</a></li>
                        <li><a class="dropdown-item" href="#" onclick="filterTable('recent')">Recently Added</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="customerTable">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 text-center" width="80">Photo</th>
                            <th class="border-0">Customer Details</th>
                            <th class="border-0">Contact Information</th>
                            <th class="border-0">Address</th>
                            <th class="border-0 text-center" width="200">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr class="customer-row">
                                <td class="text-center align-middle">
                                    <div class="avatar-container">
                                        <img src="@customer.CustPhoto"
                                             alt="@customer.Name"
                                             class="rounded-circle shadow-sm customer-avatar"
                                             onerror="this.src='data:image/svg+xml;base64,'">
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <div class="customer-info">
                                        <h6 class="mb-1 fw-bold">@customer.Name</h6>
                                        <small class="text-muted">Customer ID: @customer.RowKey</small>
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <div class="contact-info">
                                        <div class="mb-1">
                                            <i class="fas fa-envelope text-muted me-2"></i>
                                            <a href="mailto:@customer.Email" class="text-decoration-none">@customer.Email</a>
                                        </div>
                                        <div>
                                            <i class="fas fa-phone text-muted me-2"></i>
                                            <a href="tel:@customer.PhoneNumber" class="text-decoration-none">@customer.PhoneNumber</a>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <div class="address-info">
                                        <i class="fas fa-map-marker-alt text-muted me-2"></i>
                                        <span>@customer.Address</span>
                                    </div>
                                </td>
                                <td class="text-center align-middle">
                                    <div class="btn-group-vertical btn-group-sm d-md-none" role="group">
                                        <a asp-action="Details"
                                           asp-route-partitionKey="@customer.PartitionKey"
                                           asp-route-rowKey="@customer.RowKey"
                                           class="btn btn-outline-info btn-sm mb-1"
                                           title="View Details">
                                            <i class="fas fa-eye me-1"></i>Details
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-partitionKey="@customer.PartitionKey"
                                           asp-route-rowKey="@customer.RowKey"
                                           class="btn btn-outline-warning btn-sm mb-1"
                                           title="Edit Customer">
                                            <i class="fas fa-edit me-1"></i>Edit
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-partitionKey="@customer.PartitionKey"
                                           asp-route-rowKey="@customer.RowKey"
                                           class="btn btn-outline-danger btn-sm"
                                           title="Delete Customer"
                                           onclick="return confirm('Are you sure you want to delete this customer?')">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </a>
                                    </div>

                                    <div class="btn-group btn-group-sm d-none d-md-flex" role="group">
                                        <a asp-action="Details"
                                           asp-route-partitionKey="@customer.PartitionKey"
                                           asp-route-rowKey="@customer.RowKey"
                                           class="btn btn-outline-info btn-sm"
                                           title="View Details">
                                            <i class="fas fa-eye"></i>
                                            <span class="d-none d-lg-inline ms-1">Details</span>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-partitionKey="@customer.PartitionKey"
                                           asp-route-rowKey="@customer.RowKey"
                                           class="btn btn-outline-warning btn-sm"
                                           title="Edit Customer">
                                            <i class="fas fa-edit"></i>
                                            <span class="d-none d-lg-inline ms-1">Edit</span>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-partitionKey="@customer.PartitionKey"
                                           asp-route-rowKey="@customer.RowKey"
                                           class="btn btn-outline-danger btn-sm"
                                           title="Delete Customer"
                                           onclick="return confirm('Are you sure you want to delete this customer?')">
                                            <i class="fas fa-trash"></i>
                                            <span class="d-none d-lg-inline ms-1">Delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-users fa-5x text-muted"></i>
            </div>
            <h4 class="text-muted">No Customers Found</h4>
            <p class="text-muted mb-4">Get started by adding your first customer to the system.</p>
            <a class="btn btn-primary btn-lg" asp-action="Create">
                <i class="fas fa-plus-circle me-2"></i>Add First Customer
            </a>
        </div>
    }
</div>

<style>

    .main-content {
        margin-top: 0;
        padding-top: 20px;
    }

    /* Override any conflicting navbar styles */
    .navbar-fixed-top,
    .navbar-static-top {
        position: relative !important;
    }


    .customer-avatar {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border: 2px solid #e3e6f0;
    }

    .avatar-container {
        position: relative;
        display: inline-block;
    }

    .customer-info h6 {
        color: #5a5c69;
        font-size: 1rem;
    }

    .contact-info a {
        color: #5a5c69;
        font-size: 0.875rem;
    }

        .contact-info a:hover {
            color: #4e73df;
        }

    .address-info {
        color: #5a5c69;
        font-size: 0.875rem;
    }

    .customer-row:hover {
        background-color: #f8f9fc;
        transform: translateY(-1px);
        transition: all 0.15s ease-in-out;
    }

    .btn-group-sm .btn {
        border-radius: 0.35rem;
        margin: 0 1px;
    }

    .card {
        border: none;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15) !important;
    }

    .table th {
        font-weight: 600;
        color: #5a5c69;
        font-size: 0.875rem;
        text-transform: uppercase;
    }


    }

    /* Loading animation for images */
    .customer-avatar {
        animation: fadeIn 0.5s ease-in;
    }

    }

    /* Enhanced button styles */
    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    .shadow-sm {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
    }
</style>

<script>
    // Simple filter functionality
    function filterTable(filter) {
        const rows = document.querySelectorAll('.customer-row');

        rows.forEach(row => {
            if (filter === 'all') {
                row.style.display = '';
            } else if (filter === 'recent') {
                // This is a placeholder - you'd implement actual logic based on your date fields
                row.style.display = '';
            }
        });
    }

    // Search functionality (optional addition)
    document.addEventListener('DOMContentLoaded', function() {
        // Add search functionality if needed
        const searchInput = document.getElementById('customerSearch');
        if (searchInput) {
            searchInput.addEventListener('keyup', function() {
                const filter = this.value.toLowerCase();
                const rows = document.querySelectorAll('.customer-row');

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(filter) ? '' : 'none';
                });
            });
        }
    });
</script>