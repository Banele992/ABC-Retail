@model ShoppingCartView

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container my-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Shopping Cart</h3>
            @if (!string.IsNullOrEmpty(ViewBag.CartMessage))
            {
                <span class="badge bg-success">@ViewBag.CartMessage</span>
            }
        </div>
        <div class="card-body p-4">

            @if (Model.CartItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Category</th>
                                <th class="text-end">Price</th>
                                <th>Description</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <td>@item.Product.ProductName</td>
                                    <td>@item.Product.ProductCategory</td>
                                    <td class="text-end">R @item.Product.ProductPrice?.ToString("N2")</td>
                                    <td>@item.Product.ProductDescription</td>
                                    <td class="text-end">
                                        R @((item.Product.ProductPrice * item.Total)?.ToString("N2"))
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="ShoppingCart" asp-action="RemoveItem"
                                           asp-route-id="@item.Product.PartitionKey"
                                           class="btn btn-sm btn-outline-danger me-2">
                                            <i class="bi bi-trash"></i> Remove
                                        </a>
                                        <a asp-controller="ShoppingCart" asp-action="OrderItems"
                                           class="btn btn-sm btn-success">
                                            <i class="bi bi-bag-check"></i> Order
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Cart Summary -->
                <div class="d-flex justify-content-end mt-4">
                    <div class="card p-3 shadow-sm" style="min-width: 250px;">
                        <h5 class="mb-3">Cart Summary</h5>
                        <p class="mb-1">
                            <strong>Total Items:</strong> @Model.CartItems.Sum(i => i.Total)
                        </p>
                        <p class="mb-1">
                            <strong>Total Price:</strong>
                            R @Model.CartItems.Sum(i => i.Product.ProductPrice * i.Total)?.ToString("N2")
                        </p>
                        <div class="d-grid mt-3">
                            <a asp-controller="ShoppingCart" asp-action="OrderItems" class="btn btn-lg btn-primary">
                                Proceed to Checkout
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    Your shopping cart is empty.
                </div>
            }
        </div>
    </div>
</div>
