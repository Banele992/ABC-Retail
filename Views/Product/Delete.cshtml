@model ABCRetail.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="col-lg-6 col-md-8 col-sm-10">
        <div class="card shadow border-0">
            <div class="card-header bg-danger text-white text-center">
                <h4 class="mb-0">Delete Product</h4>
            </div>
            <div class="card-body text-center">
                <h5 class="mb-3">Are you sure you want to delete this product?</h5>

                <!-- Product Image -->
                <div class="mb-3">
                    <img src="@Model.ProductImage" alt="@Model.ProductName"
                         class="rounded border" width="140" height="140"
                         style="object-fit: cover;" />
                </div>

                <!-- Product Info -->
                <ul class="list-group list-group-flush text-start mb-4">
                    <li class="list-group-item"><strong>Name:</strong> @Model.ProductName</li>
                    <li class="list-group-item"><strong>Price:</strong> $@Model.ProductPrice</li>
                    <li class="list-group-item"><strong>Description:</strong> @Model.ProductDescription</li>
                </ul>

                <!-- Confirmation Buttons -->
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="PartitionKey" />
                    <input type="hidden" asp-for="RowKey" />

                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-danger px-4">Yes, Delete</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
